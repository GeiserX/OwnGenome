/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config: every optional step
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nextflow run main.nf -profile docker,everything --input ... --reference ... \
        --<database> <path> ...

    The tool rows and the switch rows of assets/everything.tsv, as
    EVERYTHING=true in scripts/run-all.sh sets them: every --tools name but
    exomiser (it runs when --hpo names the symptoms) and cram_archive (an
    archive copy of each BAM), plus KIR typing, OptiType and the four
    academic-only PGS scores (setup.sh --prs-academic). Pass every
    database the tools need: main.nf stops before any task and names the
    option a tool lacks. `og dev everything-check` fails when this file and
    the list differ.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    tools = 'pharmcat,cpic,clinvar,pypgx,vep,vcfanno,slivar,clinical_filter,cpsr,roh,prs,ancestry,ancestry_fine,mito_haplogroup,hla_typing,expansion_hunter,stranger,telomere_hunter,mosdepth,mito_variants,cyrius,manta,delly,cnvpytor,duphold,annotsv,survivor_merge,sample_qc,parascopy,paraphase,y_haplogroup,html_report,multiqc,consumer_export,bloodtype,lpa,vntyper,traits,archaic,ancient,y_str,viral,chip,mei,mocha,locityper'
    kir                     = true
    hla_qc                  = true
    cpsr_secondary_findings = true
    pgs_academic            = true
}
