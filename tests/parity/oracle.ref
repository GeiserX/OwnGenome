# The Python each og tool replaced, kept runnable after its deletion.
# tool<TAB>commit<TAB>source<TAB>interpreter<TAB>og words
#   commit       the parent of the pull request that deleted it
#   source       heredoc:FILE:NAME (the body of NAME=$(cat <<'X' ... X) in FILE) or file:FILE
#   interpreter  what runs the source: `exec INTERPRETER PROG "$@"`. A tool that was one
#                subcommand of a Python program gets it through sh -c (the pgx rows)
#   og words     the og subcommand that replaces it; the oracle gets the arguments after them
setup-mask-fasta	23a028d37fbceb465ae4de8a263f5da6c9ec8e80	heredoc:scripts/setup.sh:MASK_FASTA_PY	python3	setup mask-fasta
pgx-cyp2d6-bed	81567aa8960b30dd8df91d6ad4a2f88f5501ace6	file:bin/cyp2d6_depth_check.py	sh -c 'exec python3 "$0" bed "$@"'	pgx cyp2d6-bed
pgx-cyp2d6-measure	81567aa8960b30dd8df91d6ad4a2f88f5501ace6	file:bin/cyp2d6_depth_check.py	sh -c 'exec python3 "$0" measure "$@"'	pgx cyp2d6-measure
pgx-cyp2d6-check	81567aa8960b30dd8df91d6ad4a2f88f5501ace6	file:bin/cyp2d6_depth_check.py	sh -c 'exec python3 "$0" measure "$@"'	pgx cyp2d6-check
str-motif	81567aa8960b30dd8df91d6ad4a2f88f5501ace6	file:bin/rfc1_motif.py	python3	str motif
